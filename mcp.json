{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mostra": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mostra/cli@0.15.1",
        "mcp",
        "--embedded"
      ]
    },
    "mostra-remote": {
      "type": "streamable-http",
